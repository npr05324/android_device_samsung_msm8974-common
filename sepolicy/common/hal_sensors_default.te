r_dir_file(hal_sensors_default, efs_file)

allow hal_sensors_default {
    iio_device
    sensors_device
}:chr_file r_file_perms;

allow hal_sensors_default {
    sysfs_iio
    sysfs_input
    sysfs_sensors
}:dir r_dir_perms;

allow hal_sensors_default {
    sysfs_batteryinfo
    sysfs_graphics
    sysfs_leds
    sysfs_sec_thermistor
}:dir search;

allow hal_sensors_default {
    sysfs_batteryinfo
    sysfs_graphics
    sysfs_sec_thermistor
}:file r_file_perms;

allow hal_sensors_default {
    sysfs_iio
    sysfs_input
    sysfs_sensors
}:file rw_file_perms;

allow hal_sensors_default {
    sysfs_iio
    sysfs_input
    sysfs_sensors
}:lnk_file read;

allow hal_sensors_default sensors_data_file:dir create_dir_perms;
allow hal_sensors_default sensors_data_file:file create_file_perms;
